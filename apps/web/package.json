{
  "name": "@induction/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:candidate": "vite --mode candidate",
    "build": "tsc --noEmit -p tsconfig.json && vite build && vite build --mode candidate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "preview:candidate": "vite preview --mode candidate",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@induction/shared": "*",
    "@tanstack/react-query": "^5.62.0",
    "framer-motion": "^14.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.11.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
