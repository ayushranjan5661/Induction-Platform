# Copy to .env and fill in. Placeholder values only - never commit real secrets.

# Database (local PostgreSQL, no Docker). Must use the postgresql:// scheme.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/LevelShift_Induction

# development | test | production. Set to production on any shared or deployed server:
# it turns on secure cookies and switches off the demo sign-in.
NODE_ENV=development

# Auth: 'dev' adds one-click demo sign-in for @example.com accounts (never in production);
# 'password' switches it off.
AUTH_PROVIDER=dev
JWT_SECRET=change-me
# Optional, at least 32 characters: encrypts staff default passwords shown to admins on
# Employee Accounts. When blank, a key is derived from JWT_SECRET. Changing either key
# makes stored default passwords unreadable until a New password is issued.
CREDENTIALS_KEY=

# Azure OpenAI, used only by the HR AI assistant (server-side only - do NOT prefix with VITE_).
# Leave empty to run without the assistant; everything else still works.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Speech and avatars need no keys: the browser's built-in voices (Web Speech API)
# speak the scripts, and the presenters are drawn and animated in the web app.

# Apps: two web apps on separate ports. Staff (Admin, HR, Legal) and candidates.
APP_URL=http://localhost:5173
# Candidate app: sign-in, invitation links and the induction. Defaults to http://localhost:5174.
CANDIDATE_APP_URL=http://localhost:5174
# The two sign-in pages, shown in the sign-in details HR and admins hand out.
# Optional: they default to APP_URL + /login and CANDIDATE_APP_URL + /candidate.
STAFF_LOGIN_URL=
CANDIDATE_LOGIN_URL=
# The web apps link to each other with these (read by Vite from apps/web/.env*). Defaults match the above.
# VITE_STAFF_APP_URL=http://localhost:5173
# VITE_CANDIDATE_APP_URL=http://localhost:5174

# Optional, development only: gives every seeded account this password when `npm run db:seed` runs.
# Leave empty to seed accounts without a password (use the demo buttons on the login page instead).
SEED_PASSWORD=
API_URL=http://localhost:3000
API_PORT=3000

# Super Admin account (full control of the platform). Set real values in .env only.
# When email and password are both set, the API creates or updates this Admin account at
# startup; changing the password here and restarting the API resets it. Password: 8+ characters.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
